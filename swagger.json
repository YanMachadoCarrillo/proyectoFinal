{
  "openapi": "3.0.0",
  "info": {
    "title": "Pokemon API",
    "version": "1.0.0",
    "description": "API para obtener pokemones desde MySQL"
  },
  "paths": {
    "/api/pokemon": {
      "get": {
        "summary": "Obtener lista de Pokemones",
        "responses": {
          "200": {
            "description": "Lista de pokemones exitosa",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "id": { "type": "integer" },
                      "nombre": { "type": "string" },
                      "tipo": { "type": "string" },
                      "nivel": { "type": "integer" },
                      "imagen": { "type": "string" }
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
