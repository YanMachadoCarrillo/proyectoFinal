{
  "openapi": "3.0.0",
  "info": {
    "title": "Pokemon API",
    "version": "1.0.0",
    "description": "Microservicio de Pokémon conectado a MySQL",
    "contact": {
      "name": "Yan Carlos"
    }
  },
  "servers": [
    {
      "url": "http://localhost:3001",
      "description": "Servidor Local"
    },
    {
      "url": "https://proyectofinal-ta9q.onrender.com",
      "description": "Servidor Producción"
    }
  ],
  "tags": [
    {
      "name": "Health",
      "description": "Estado del microservicio"
    },
    {
      "name": "Pokemon",
      "description": "Endpoints de Pokémon"
    }
  ],
  "paths": {
    "/": {
      "get": {
        "tags": ["Health"],
        "summary": "Health Check",
        "description": "Verifica si el microservicio está funcionando",
        "responses": {
          "200": {
            "description": "Servicio funcionando",
            "content": {
              "application/json": {
                "example": {
                  "service": "Pokemon API",
                  "status": "running"
                }
              }
            }
          }
        }
      }
    },
    "/api/pokemon": {
      "get": {
        "tags": ["Pokemon"],
        "summary": "Obtener lista de Pokémon",
        "description": "Retorna todos los Pokémon almacenados en MySQL",
        "responses": {
          "200": {
            "description": "Lista de Pokémon obtenida correctamente",
            "content": {
              "application/json": {
                "schema": {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/Pokemon"
                  }
                },
                "example": [
                  {
                    "id": 1,
                    "nombre": "Pikachu",
                    "altura": 30.0,
                    "peso": 6.0,
                    "habilidades": "[\"Static\",\"Lightning Rod\"]",
                    "imagen_frontal": "https://automlucas.com/img/front/Pikachu",
                    "imagen_trasera": "https://automlucas.com/img/back/Pikachu"
                  },
                  {
                    "id": 2,
                    "nombre": "Charizard",
                    "altura": 1.7,
                    "peso": 90.5,
                    "habilidades": "[\"Blaze\",\"Solar Power\"]",
                    "imagen_frontal": "https://automlucas.com/img/front/Charizard",
                    "imagen_trasera": "https://automlucas.com/img/back/Charizard"
                  }
                ]
              }
            }
          },
          "500": {
            "description": "Error interno del servidor",
            "content": {
              "application/json": {
                "example": {
                  "error": "Internal Server Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "Pokemon": {
        "type": "object",
        "required": [
          "id",
          "nombre",
          "altura",
          "peso",
          "habilidades",
          "imagen_frontal",
          "imagen_trasera"
        ],
        "properties": {
          "id": {
            "type": "integer",
            "example": 1
          },
          "nombre": {
            "type": "string",
            "example": "Pikachu"
          },
          "altura": {
            "type": "number",
            "example": 30.0
          },
          "peso": {
            "type": "number",
            "example": 6.0
          },
          "habilidades": {
            "type": "string",
            "example": "[\"Static\",\"Lightning Rod\"]"
          },
          "imagen_frontal": {
            "type": "string",
            "format": "uri",
            "example": "https://automlucas.com/img/front/Pikachu"
          },
          "imagen_trasera": {
            "type": "string",
            "format": "uri",
            "example": "https://automlucas.com/img/back/Pikachu"
          }
        }
      }
    }
  }
}
